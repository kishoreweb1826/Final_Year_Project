# ── Neon PostgreSQL ──────────────────────────
DATABASE_URL=jdbc:postgresql://<NEON_HOST>/<DB_NAME>?sslmode=require
SPRING_DATASOURCE_USERNAME=<NEON_USER>
SPRING_DATASOURCE_PASSWORD=<NEON_PASSWORD>

# ── JWT ──────────────────────────────────────
JWT_SECRET=<MIN_256_BIT_SECRET>

# ── CORS ─────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# ── Mail ─────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
